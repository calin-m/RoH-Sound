{
  "file-approval-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "replace_file_content|write_to_file|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/approval-gate.js",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
