{
  "$schema": "https://unpkg.com/knip@5/overview/schema.json",
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "src/components/ui/*.tsx",
    "src/components/presentation/*.tsx",
    "src/mocks/browser.ts",
    "src/mocks/server.ts",
    "src/mocks/handlers.ts",
    "scripts/**/*.js"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.js"],
  "ignoreDependencies": [
    "@oxc-parser/binding-wasm32-wasi",
    "husky",
    "tailwindcss"
  ],
  "rules": {
    "exports": "warn"
  }
}
